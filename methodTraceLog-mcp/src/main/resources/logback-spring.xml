<?xml version="1.0" encoding="UTF-8"?>
<!--
  MCP server uses stdio transport (stdout = JSON-RPC).
  All ConsoleAppenders MUST write to System.err to avoid corrupting the
  JSON-RPC protocol on stdout.

  We intentionally keep the pattern minimal (single line per log record)
  and silence noisy framework loggers so the agent's logs don't drown in
  Spring/MCP transport chatter.
-->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDERR"/>
    </root>

    <logger name="org.springframework" level="WARN"/>
    <logger name="io.opentelemetry" level="WARN"/>
    <logger name="reactor" level="WARN"/>
</configuration>
