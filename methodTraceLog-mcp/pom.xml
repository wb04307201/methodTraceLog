<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.wb04307201</groupId>
        <artifactId>methodTraceLog-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>methodTraceLog-mcp</artifactId>
    <name>methodTraceLog-mcp</name>
    <packaging>jar</packaging>

    <description>
        Standalone Model Context Protocol (MCP) server for methodTraceLog.
        Communicates with AI agents over stdio, and forwards tool calls to the
        host application (which embeds the methodTraceLog starter) via HTTP.
        Hosts are configured in application.yml under method-trace-log.mcp.hosts.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
