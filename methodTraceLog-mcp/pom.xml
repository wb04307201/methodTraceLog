<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.wb04307201</groupId>
        <artifactId>methodTraceLog-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>methodTraceLog-mcp</artifactId>
    <name>methodTraceLog-mcp</name>
    <packaging>jar</packaging>

    <description>
        Standalone Model Context Protocol (MCP) server for methodTraceLog.
        Communicates with AI agents over stdio, and forwards tool calls to the
        host application (which embeds the methodTraceLog starter) via HTTP.
        Hosts are configured in application.yml under method-trace-log.mcp.hosts.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!--
          Round 15 (MCP-R-08): Apache HttpClient 5 backs the forwarding RestClient beans.
          Its CloseableHttpClient is closed via @Bean(destroyMethod="close") so the connection
          pool is released cleanly on context shutdown. Version is pinned by spring-boot-dependencies
          BOM (httpclient5.version = 5.5.2 for spring-boot 3.5.14).
        -->
        <dependency>
            <groupId>org.apache.httpcomponents.client5</groupId>
            <artifactId>httpclient5</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
